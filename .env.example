# -----------------------------------------------------------------------------
# Smart Campus — backend environment configuration
# Copy this file to ".env" to override any of the defaults below.
# Every value here is OPTIONAL: the server runs with sensible defaults if no
# .env file exists at all.
# -----------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
# Default is a zero-config SQLite file created next to the app on first run.
# To use PostgreSQL in production, install a driver (e.g. `pip install psycopg2-binary`)
# and set, for example:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smartcampus
DATABASE_URL=sqlite:///./smart_campus.db

# --- Security -----------------------------------------------------------------
# CHANGE THIS in production. Used to sign JWT access/refresh tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Token lifetimes (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins for the browser frontend.
# "*" (the default) allows any origin, which is convenient for local development.
# Lock this down in production, e.g.:
#   CORS_ORIGINS=https://smartcampus.edu.gh,https://app.smartcampus.edu.gh
CORS_ORIGINS=*

# --- Demo data ----------------------------------------------------------------
# When true (default), the database is seeded with demo accounts and data on
# first startup if it is empty. Set to false to start with an empty database.
SEED_ON_STARTUP=true
